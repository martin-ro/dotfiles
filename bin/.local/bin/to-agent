#!/usr/bin/env python3
"""Resolve herdr agent panes (claude, pi, ...) and send a code reference to one.

Subcommands:
  to-agent panes                      list candidate agent panes as "pane_id\\tlabel"
  to-agent send <pane_id> <ref> [note]  send "@<ref> [note]" to a pane
"""
import json
import os
import subprocess
import sys

os.environ["PATH"] = os.path.expanduser("~/.local/bin") + os.pathsep + os.environ.get("PATH", "")


def herdr(*args):
    result = subprocess.run(
        ["herdr", *args], capture_output=True, text=True
    )
    if result.returncode != 0:
        raise RuntimeError((result.stderr or result.stdout).strip())
    return result.stdout


def herdr_json(*args):
    return json.loads(herdr(*args)).get("result", {})


def candidates():
    panes = herdr_json("pane", "list").get("panes", [])

    self_id = self_ws = self_tab = None
    for p in panes:
        if p.get("focused"):
            self_id = p.get("pane_id")
            self_ws = p.get("workspace_id")
            self_tab = p.get("tab_id")

    def collect(scoped):
        return [
            p
            for p in panes
            if p.get("agent")
            and p.get("pane_id") != self_id
            and (not scoped or p.get("workspace_id") == self_ws)
        ]

    found = collect(self_ws is not None)
    if not found:
        found = collect(False)

    found.sort(
        key=lambda p: (
            p.get("agent_status") != "idle",
            p.get("tab_id") != self_tab,
            p.get("pane_id") or "",
        )
    )
    if not found:
        found = [p for p in panes if p.get("agent")]
    return found


def display_for(pane, tab_cache):
    pane_label = pane.get("label")
    if not pane_label:
        try:
            info = herdr_json("pane", "get", pane["pane_id"]).get("pane", {})
            pane_label = info.get("label")
        except RuntimeError:
            pane_label = None

    tab_id = pane.get("tab_id")
    if tab_id and tab_id not in tab_cache:
        try:
            tab = herdr_json("tab", "get", tab_id).get("tab", {})
            tab_cache[tab_id] = tab.get("label") or ("tab " + str(tab.get("number")))
        except RuntimeError:
            tab_cache[tab_id] = None

    name = pane_label or pane["pane_id"]
    status = pane.get("agent_status") or "?"
    agent = pane.get("agent") or "?"
    tab_label = tab_cache.get(tab_id)
    if tab_label:
        return "{} · {}  [{} · {}]".format(tab_label, name, agent, status)
    return "{}  [{} · {}]".format(name, agent, status)


def cmd_panes():
    tab_cache = {}
    rows = candidates()
    if not rows:
        sys.stderr.write("to-agent: no agent panes found\n")
        return 1
    for pane in rows:
        print("{}\t{}".format(pane["pane_id"], display_for(pane, tab_cache)))
    return 0


def cmd_send(argv):
    if len(argv) < 2:
        sys.stderr.write("usage: to-agent send <pane_id> <ref> [note]\n")
        return 2
    pane_id, ref = argv[0], argv[1]
    note = argv[2] if len(argv) > 2 else ""

    payload = "@{}".format(ref)
    if note.strip():
        payload += " {}".format(note.strip())

    herdr("pane", "send-text", pane_id, payload)
    try:
        herdr("pane", "send-keys", pane_id, "enter")
    except RuntimeError:
        herdr("pane", "send-keys", pane_id, "Enter")
    print("sent {} → {}".format(ref, pane_id))
    return 0


def main():
    argv = sys.argv[1:]
    if not argv:
        sys.stderr.write(__doc__)
        return 2
    sub, rest = argv[0], argv[1:]
    try:
        if sub == "panes":
            return cmd_panes()
        if sub == "send":
            return cmd_send(rest)
    except RuntimeError as err:
        sys.stderr.write("to-agent: {}\n".format(err))
        return 1
    sys.stderr.write("to-agent: unknown subcommand '{}'\n".format(sub))
    return 2


if __name__ == "__main__":
    sys.exit(main())
