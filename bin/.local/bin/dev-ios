#!/usr/bin/env bash
# dev-ios / dev-android — build a box repo on the Mac and run it on a device or
# simulator. Runs on the box (beelink): pushes the repo to the Mac with rsync,
# then ships this file over ssh and runs its Darwin half there. The Mac needs no
# copy of this script, so the two sides cannot drift apart. The platform comes
# from the invoked name (dev-android is a symlink to this script).
#
#   dev-ios <name|repo/wt|branch|path> [udid] [native:run args]
#   dev-android <name> [udid]
#   dev-ios                       # infer the repo from the current directory
#
# <name> resolves to ~/Work/<name>, ~/code/<name>, a worktree (<repo>/<wt> or its
# basename), a checked-out branch (via git worktree list) or an absolute path.
# The Mac mirror lives at ~/code/<path relative to ~/Work or ~/code>.
# Without a udid, native:run prompts (TTY) or reuses the last device (no TTY).
# Pass -W for hot reload; NativePHP only supports it on simulators.
#
# On the Mac (also usable directly):  dev-ios <dir> [udid] [native:run args]
set -euo pipefail

PLATFORM="${DEV_PLATFORM:-${0##*/}}"
PLATFORM="${PLATFORM#dev-}"
case "$PLATFORM" in
  ios|android) ;;
  *) echo "invoke as dev-ios or dev-android (got: $0)" >&2; exit 1 ;;
esac

# Each side owns these: never pushed to the Mac, never pulled back.
# A project can leave more out with a .rsync-filter file in its root (rsync -F).
EXCLUDES=(--exclude=/.git --exclude=/vendor --exclude=/node_modules --exclude=/nativephp
  --exclude=/public/build --exclude='/public/*-hot' --exclude=/public/storage
  --exclude=/storage/framework --exclude=/storage/logs --exclude=/bootstrap/cache)

# ---- box: resolve, push, run on the Mac --------------------------------------
if [[ "$(uname -s)" != "Darwin" ]]; then
  MAC="${DEV_MAC:-mac}"
  if [[ $# -ge 1 && "$1" != -* ]]; then Q="$1"; shift; else Q="$PWD"; fi

  resolve() {
    local q="$1" p m
    for p in "$q" ~/Work/"$q" ~/code/"$q" ~/Work/worktrees/"$q" ~/code/worktrees/"$q" \
             ~/Work/worktrees/*/"$q" ~/code/worktrees/*/"$q"; do
      [[ -d "$p" ]] && { realpath "$p"; return; }
    done
    m=$(for p in ~/Work/*/ ~/code/*/; do git -C "$p" worktree list --porcelain 2>/dev/null; done \
      | awk -v want="refs/heads/$q" '/^worktree /{w=substr($0,10)} /^branch / && substr($0,8)==want {print w}' | sort -u)
    [[ $(wc -l <<<"$m") -le 1 ]] || { printf "'%s' matches several worktrees:\n%s\n" "$q" "$m" >&2; return 1; }
    [[ -n "$m" ]] && echo "$m"
  }
  BOX_PATH=$(resolve "$Q") || { echo "'$Q' not found (~/Work, ~/code, worktree, branch or path)" >&2; exit 1; }

  REL="${BOX_PATH#"$HOME/Work/"}"; REL="${REL#"$HOME/code/"}"
  [[ "$REL" == /* ]] && REL="${REL##*/}"
  MAC_DIR="code/$REL"
  echo "==> $BOX_PATH  ->  $MAC:~/$MAC_DIR"
  ssh "$MAC" "mkdir -p ~/$MAC_DIR"
  rsync -a -F --delete "${EXCLUDES[@]}" "$BOX_PATH/" "$MAC:$MAC_DIR/"

  FIRST=0; [[ -f "$BOX_PATH/nativephp.lock" ]] || FIRST=1
  TTY=(-t); [[ -t 0 ]] || { TTY=(-T); set -- "$@" --no-interaction --no-tty; }
  status=0
  ssh "${TTY[@]}" "$MAC" "DEV_PLATFORM=$PLATFORM bash <(echo $(base64 -w0 "$0") | base64 -d) $(printf '%q ' "$MAC_DIR" "$@")" || status=$?
  # native:install (first run, Mac only) writes .env keys, nativephp.lock, config and
  # native/. Pull them back so the box stays the git source of truth.
  (( FIRST )) && rsync -a -F "${EXCLUDES[@]}" "$MAC:$MAC_DIR/" "$BOX_PATH/"
  exit $status
fi

# ---- Mac: build and run in <dir> ---------------------------------------------
export PATH="$HOME/.bun/bin:/opt/homebrew/bin:$PATH"   # ssh shells lack bun and pod
# ssh shells also skip ~/.zprofile on the Mac, which sets these two. Without them
# Gradle takes the system Java 11 (Android needs 17) and finds no SDK.
export JAVA_HOME="${JAVA_HOME:-/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home}"
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
cd "${1:?usage: dev-$PLATFORM <dir> [udid] [native:run args]}"; shift

# ssh sessions see the login keychain as locked, so CodeSign fails with
# errSecInternalComponent. Store the Mac login password once:
#   umask 077; mkdir -p ~/.config/dev-ios; printf '%s' 'PASSWORD' > ~/.config/dev-ios/keychain-password
PW="$HOME/.config/dev-ios/keychain-password"
[[ -r "$PW" ]] && security unlock-keychain -p "$(<"$PW")" ~/Library/Keychains/login.keychain-db

# Herd applies PHP isolation via shell aliases (php, composer), which scripts
# don't inherit — call the 8.5 binary directly and run composer's phar with it.
PHP="$HOME/Library/Application Support/Herd/bin/php85"
[[ -x "$PHP" ]] || PHP=php
COMPOSER="$HOME/Library/Application Support/Herd/bin/composer"
[[ -f "$COMPOSER" ]] || COMPOSER="$(command -v composer)"

# NativePHP's build pipeline shells out to bare `php`/`composer` (e.g. when
# bundling the app for Android), which would resolve to Herd's default PHP —
# shim both onto PATH so every child process uses the same 8.5 binary.
if [[ "$PHP" != php ]]; then
  SHIM_DIR=$(mktemp -d)
  printf '#!/bin/sh\nexec "%s" "$@"\n' "$PHP" > "$SHIM_DIR/php"
  printf '#!/bin/sh\nexec "%s" "%s" "$@"\n' "$PHP" "$COMPOSER" > "$SHIM_DIR/composer"
  chmod +x "$SHIM_DIR/php" "$SHIM_DIR/composer"
  export PATH="$SHIM_DIR:$PATH"
fi

# Laravel scratch dirs are excluded from the mirror (each side owns its own),
# so a fresh mirror starts without them — including the tracked .gitignore
# placeholders that normally live inside. Restore those too: NativePHP's build
# copies the app into nativephp/<platform>/laravel with a LEAVES_ONLY iterator,
# so an *empty* dir never makes it across, and the missing
# storage/framework/views makes view.compiled resolve to false in the copy —
# "Please provide a valid cache path" during package:discover, which fails the
# build's composer install.
mkdir -p bootstrap/cache storage/logs storage/app/public \
  storage/framework/cache/data storage/framework/sessions \
  storage/framework/testing storage/framework/views
for d in bootstrap/cache storage/logs storage/app/public \
  storage/framework/cache storage/framework/cache/data \
  storage/framework/sessions storage/framework/testing storage/framework/views; do
  [[ -e "$d/.gitignore" ]] || printf '*\n!.gitignore\n' > "$d/.gitignore"
done
[[ -e storage/framework/.gitignore ]] || printf '%s\n' \
  compiled.php config.php down events.scanned.php maintenance.php \
  routes.php routes.scanned.php 'schedule-*' services.json \
  > storage/framework/.gitignore

# Always reconcile deps: composer.json/lock sync from the box but vendor/ and
# node_modules don't, so a `composer require` on the box otherwise leaves the
# Mac building against stale deps. Both are near-instant no-ops when current.
"$PHP" "$COMPOSER" install --no-interaction --no-progress --quiet
[[ -f package.json ]] && bun install --silent
if [[ ! -d "nativephp/$PLATFORM" ]]; then
  echo "==> scaffolding native $PLATFORM project (first run)"
  # The installer's "star us on GitHub?" confirm defaults to yes, and
  # --no-interaction accepts defaults — shadow `open` so no browser pops.
  OPEN_SHIM=$(mktemp -d)
  printf '#!/bin/sh\nexit 0\n' > "$OPEN_SHIM/open" && chmod +x "$OPEN_SHIM/open"
  PATH="$OPEN_SHIM:$PATH" "$PHP" artisan native:install "$PLATFORM" --no-interaction
  rm -rf "$OPEN_SHIM"
fi

npm_script() {
  [[ -f package.json ]] || return 1
  "$PHP" -r '
    $package = json_decode(file_get_contents("package.json"), true) ?: [];
    $script = $package["scripts"][$argv[1]] ?? "";
    if ($script === "") {
        exit(1);
    }
    echo $script;
  ' "$1"
}

if [[ -f package.json ]]; then
  platform_build="build:$PLATFORM"
  if npm_script "$platform_build" >/dev/null 2>&1; then
    echo "==> building Vite assets ($platform_build)"
    bun run "$platform_build"
  elif build_cmd="$(npm_script build 2>/dev/null)"; then
    if [[ "$build_cmd" == *"--mode="* ]]; then
      echo "==> building Vite assets (build)"
      bun run build
    else
      echo "==> building Vite assets (build -- --mode=$PLATFORM)"
      bun run build -- "--mode=$PLATFORM"
    fi
  fi
fi

"$PHP" artisan native:run "$PLATFORM" "$@"
# native:run exits 0 after "Build failed!"; the log (truncated per run) is the signal.
! grep -qs "BUILD FAILED" "nativephp/$PLATFORM-build.log"
