#!/usr/bin/env bash
# phone — publish local dev sites on the tailnet so they open from your phone (or any
# tailnet device). Every *.localhost Caddy vhost gets a twin at
#     https://<slug>.dev.martin.ph:8443     (slug = the site's first host label)
#
# How it works: Caddy holds ONE wildcard cert for *.dev.martin.ph (Cloudflare DNS-01)
# and serves each site by subdomain on loopback :8443; `tailscale serve` TCP-forwards
# the tailnet's :8443 straight to it (TLS passthrough). One mapping, unlimited sites.
#
#   phone            regenerate from the current sites, ensure serve is up, list URLs
#   phone sync       same, but quiet (for hooks like treeupdown)
#   phone off        tear it down (remove the vhost + tailscale serve :8443)
#
# Requires: caddy built with caddy-dns/cloudflare + CF_API_TOKEN in
# ~/.config/caddy/cf-dns.env, and a DNS record *.dev.martin.ph -> the box's tailnet IP.
set -euo pipefail

SITES="$HOME/.config/caddy/sites"
VHOST="$SITES/tailnet-dev.caddy"
CADDY_CONFIG="$HOME/.config/caddy/Caddyfile"
TOKEN_ENV="$HOME/.config/caddy/cf-dns.env"
DOMAIN="dev.martin.ph"
PORT=8443

reload_caddy() {
  # Use the plugin build (has caddy-dns/cloudflare); stock /usr/bin/caddy can't parse
  # this vhost's tls{dns cloudflare} block and would fail the reload.
  local caddy_bin="$HOME/.local/bin/caddy"
  [ -x "$caddy_bin" ] || caddy_bin=caddy
  "$caddy_bin" reload --address localhost:2019 --config "$CADDY_CONFIG" --force >/dev/null 2>&1 \
    || { echo "caddy reload failed (is the caddy user service running?)" >&2; return 1; }
}

# emit "slug<TAB>root<TAB>fpm" for each real app vhost (has a document root)
collect_sites() {
  local f host root fpm slug
  for f in "$SITES"/*.localhost*.caddy; do
    [ -e "$f" ] || continue
    host=$(sed -nE 's#^https?://([^:,[:space:]]+):[0-9].*#\1#p' "$f" | head -1)
    root=$(sed -nE 's/^[[:space:]]*root \* (.+)$/\1/p' "$f" | head -1)
    fpm=$(sed -nE 's/^[[:space:]]*php_fastcgi[[:space:]]+([^ {]+).*$/\1/p' "$f" | head -1)
    [ -n "$host" ] && [ -n "$root" ] || continue
    slug=${host%%.*}
    printf '%s\t%s\t%s\n' "$slug" "$root" "$fpm"
  done | sort -u
}

generate() {
  {
    echo "# tailnet dev sites -> *.$DOMAIN:$PORT  (generated by 'phone'; not tracked)"
    echo "*.$DOMAIN:$PORT {"
    echo "	bind 127.0.0.1"
    echo "	tls {"
    echo "		dns cloudflare {env.CF_API_TOKEN}"
    echo "		resolvers 1.1.1.1"
    echo "	}"
    echo "	encode gzip"
    while IFS=$'\t' read -r slug root fpm; do
      [ -n "$slug" ] || continue
      local m; m=$(printf '%s' "$slug" | tr -c 'a-zA-Z0-9' '_')
      echo "	@$m host $slug.$DOMAIN"
      echo "	handle @$m {"
      echo "		root * $root"
      if [ -n "$fpm" ]; then
        echo "		php_fastcgi $fpm {"
        echo "			env HTTPS on"
        echo "		}"
      fi
      echo "		file_server"
      echo "	}"
    done < <(collect_sites)
    echo "	handle {"
    echo "		respond \"no such dev site — run 'phone' on the box for the list\" 404"
    echo "	}"
    echo "}"
  } > "$VHOST"
}

list_urls() {
  echo "Dev sites on the tailnet (Tailscale on, any device):"
  collect_sites | while IFS=$'\t' read -r slug _ _; do
    [ -n "$slug" ] && echo "  https://$slug.$DOMAIN:$PORT"
  done
}

case "${1:-}" in
  off|down)
    rm -f "$VHOST"; reload_caddy || true
    tailscale serve --tcp="$PORT" off >/dev/null 2>&1 || true
    echo "Tailnet dev sites torn down (was *.$DOMAIN:$PORT)."
    exit 0 ;;
esac

quiet=0; [ "${1:-}" = sync ] && quiet=1

if [ ! -s "$TOKEN_ENV" ]; then
  echo "Cloudflare token not set yet ($TOKEN_ENV is missing/empty)." >&2
  echo "Create a scoped token and:  umask 077 && printf 'CF_API_TOKEN=%s\\n' 'TOKEN' > $TOKEN_ENV" >&2
  echo "Then restart caddy (systemctl --user restart caddy) and rerun 'phone'." >&2
  exit 1
fi

generate
# retire the old one-at-a-time exposure if present (it claimed :8443 as an HTTPS serve)
rm -f "$SITES/zz-phone.caddy"
tailscale serve --https="$PORT" off >/dev/null 2>&1 || true
reload_caddy
tailscale serve --bg --tcp="$PORT" "tcp://127.0.0.1:$PORT" >/dev/null 2>&1 || true

if [ "$quiet" = 0 ]; then
  echo "✓ synced $(collect_sites | grep -c . || true) sites to *.$DOMAIN:$PORT"
  echo
  list_urls
fi
