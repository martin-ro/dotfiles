gui:
  theme:
    activeBorderColor:
      - '{{ accent }}'
      - bold
    inactiveBorderColor:
      - '{{ foreground }}'
    optionsTextColor:
      - '{{ accent }}'
    selectedLineBgColor:
      - '{{ selection }}'
    cherryPickedCommitBgColor:
      - '{{ selection }}'
    cherryPickedCommitFgColor:
      - '{{ foreground }}'
