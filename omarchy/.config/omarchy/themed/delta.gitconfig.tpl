[delta]
    {{ mode }} = true
    plus-style = syntax "{{ mix background green 12% }}"
    minus-style = syntax "{{ mix background red 12% }}"
    plus-emph-style = syntax "{{ mix background green 28% }}"
    minus-emph-style = syntax "{{ mix background red 28% }}"
    plus-empty-line-marker-style = normal "{{ mix background green 12% }}"
    minus-empty-line-marker-style = normal "{{ mix background red 12% }}"
    zero-style = syntax
    file-style = "{{ accent }}"
    hunk-header-style = syntax
    hunk-header-decoration-style = "{{ muted }}" ul
    line-numbers-minus-style = "{{ red }}"
    line-numbers-plus-style = "{{ green }}"
    line-numbers-zero-style = "{{ muted }}"
